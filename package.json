{
  "name": "ditto",
  "version": "1.0.0",
  "description": "Aprenda inglês com frases geradas por IA e repetição espaçada",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:8080 && electron .\"",
    "build": "vite build && electron-builder --win",
    "release": "vite build && electron-builder --win --publish always",
    "vite": "vite",
    "electron": "electron ."
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "electron-updater": "^6.8.3",
    "openai": "^4.47.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.9.3",
    "vite": "^5.2.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.ditto.app",
    "productName": "Ditto",
    "asar": false,
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}.Setup.${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "vssoares",
      "repo": "ditto"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  }
}
