{
  "name": "ditto",
  "version": "1.0.4",
  "description": "Aprenda inglês com frases geradas por IA e repetição espaçada",
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "dev": "concurrently \"ng serve\" \"wait-on http://localhost:8080 && electron .\"",
    "build:electron": "ng build && electron-builder --win",
    "release": "ng build && electron-builder --win --publish always",
    "electron": "electron ."
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "electron-updater": "^6.8.3",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.2.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.ditto.app",
    "productName": "Ditto",
    "asar": false,
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}.Setup.${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "vssoares",
      "repo": "ditto"
    },
    "files": [
      "dist/ditto/browser/**/*",
      "electron/**/*"
    ]
  }
}
